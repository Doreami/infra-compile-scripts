# ============================================================
# openGauss Iceberg 联合编译 — 环境配置
# 按需修改以下路径
# ============================================================

# 多仓根目录（所有仓库和 binarylibs 的父目录）
ICEBERG_OG_ROOT="${ICEBERG_OG_ROOT:-$HOME/iceberg-og}"

# binarylibs 路径（openGauss 预编译三方库）
# 可从 openGauss 发布页下载或从已有环境复制
BINARYLIBS_DIR="${BINARYLIBS_DIR:-$ICEBERG_OG_ROOT/binarylibs}"

# binarylibs 下载地址（华为云 OBS，国内速度快）
# setup.sh 会根据 OS 版本自动拼 URL，此处仅作兜底
# openEuler 24.03 → openEuler_2403_x86_64.tar.gz（含 onnx_wrapper）
# openEuler 22.03 → openEuler_2203_x86_64.tar.gz
# 其他           → openEuler_x86_64.tar.gz
BINARYLIBS_DOWNLOAD_URL="${BINARYLIBS_DOWNLOAD_URL:-}"

# ====== 仓库源配置 ======
# 默认从 DataInfraLab 组织拉取所有仓。
#
# 场景 A — 全部 fork：只改 GITHUB_ORG
#   GITHUB_ORG="your_username"
#
# 场景 B — 单个 fork：覆盖对应的 _REPO_URL（会忽略 GITHUB_ORG）
#   ICEBERG_FDW_REPO_URL="git@github.com:your_fork/iceberg_fdw.git"
#
GITHUB_ORG="${GITHUB_ORG:-DataInfraLab}"

# 各仓 clone 地址（默认根据 GITHUB_ORG 拼接，可单独覆盖）
OPENGAUSS_REPO_URL="${OPENGAUSS_REPO_URL:-git@github.com:${GITHUB_ORG}/openGauss-server-datainfra.git}"
ICEBERG_INDEX_REPO_URL="${ICEBERG_INDEX_REPO_URL:-git@github.com:${GITHUB_ORG}/iceberg-index.git}"
ICEBERG_BRIDGE_REPO_URL="${ICEBERG_BRIDGE_REPO_URL:-git@github.com:${GITHUB_ORG}/iceberg-rust-bridge.git}"
ICEBERG_FDW_REPO_URL="${ICEBERG_FDW_REPO_URL:-git@github.com:${GITHUB_ORG}/iceberg_fdw.git}"
ICEBERG_CATALOG_REPO_URL="${ICEBERG_CATALOG_REPO_URL:-git@github.com:${GITHUB_ORG}/openGauss-Catalog.git}"
ICEBERG_DELTA_REPO_URL="${ICEBERG_DELTA_REPO_URL:-git@github.com:${GITHUB_ORG}/iceberg_delta.git}"
ICEBERG_RUST_DATAINFRA_REPO_URL="${ICEBERG_RUST_DATAINFRA_REPO_URL:-git@github.com:${GITHUB_ORG}/iceberg-rust-datainfra.git}"
ICEBERG_ARROW_DEPS_REPO_URL="${ICEBERG_ARROW_DEPS_REPO_URL:-git@github.com:${GITHUB_ORG}/iceberg-arrow-deps.git}"
ICEBERG_RUST_CACHE_REPO_URL="${ICEBERG_RUST_CACHE_REPO_URL:-git@github.com:${GITHUB_ORG}/iceberg-rust-cache.git}"


# GitHub 认证（如果服务器无法匿名访问 GitHub）
# Classic PAT: Settings → Developer settings → Personal access tokens → Tokens (classic)
# 勾选 public_repo 即可
# GITHUB_USER="your_username"
# GITHUB_TOKEN="ghp_xxxx"

# Rust 镜像（国内加速）
# rustup 安装 toolchain 用 rsproxy（速度最快）
# 可选: https://mirrors.tuna.tsinghua.edu.cn/rustup
#       https://mirrors.ustc.edu.cn/rust-static/rustup
RUSTUP_DIST_SERVER="${RUSTUP_DIST_SERVER:-https://rsproxy.cn}"
RUSTUP_UPDATE_ROOT="${RUSTUP_UPDATE_ROOT:-https://rsproxy.cn/rustup}"

# 编译模式: debug | release | memcheck
BUILD_MODE="${BUILD_MODE:-debug}"

# 编译并发数
BUILD_JOBS="${BUILD_JOBS:-8}"

# 各仓默认分支（--pull 时用于 git fetch + checkout + pull）
OPENGAUSS_BRANCH="${OPENGAUSS_BRANCH:-datainfra_dev}"
ICEBERG_INDEX_BRANCH="${ICEBERG_INDEX_BRANCH:-main}"
ICEBERG_BRIDGE_BRANCH="${ICEBERG_BRIDGE_BRANCH:-main}"
ICEBERG_FDW_BRANCH="${ICEBERG_FDW_BRANCH:-main}"
ICEBERG_CATALOG_BRANCH="${ICEBERG_CATALOG_BRANCH:-main}"
ICEBERG_DELTA_BRANCH="${ICEBERG_DELTA_BRANCH:-master}"
ICEBERG_RUST_DATAINFRA_BRANCH="${ICEBERG_RUST_DATAINFRA_BRANCH:-main}"
ICEBERG_ARROW_DEPS_BRANCH="${ICEBERG_ARROW_DEPS_BRANCH:-master}"
ICEBERG_RUST_CACHE_BRANCH="${ICEBERG_RUST_CACHE_BRANCH:-main}"

# Arrow 安装路径（delta 依赖）
ARROW_HOME="${ARROW_HOME:-$ICEBERG_OG_ROOT/arrow_install}"