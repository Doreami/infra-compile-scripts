# ============================================================
# openGauss Iceberg 联合编译 — 环境配置
# 按需修改以下路径
# ============================================================

# 多仓根目录（所有仓库和 binarylibs 的父目录）
ICEBERG_OG_ROOT="${ICEBERG_OG_ROOT:-$HOME/iceberg-og}"

# binarylibs 路径（openGauss 预编译三方库）
# 可从 openGauss 发布页下载或从已有环境复制
# 下载地址: https://opengauss.org/zh/download/
BINARYLIBS_DIR="${BINARYLIBS_DIR:-$ICEBERG_OG_ROOT/binarylibs}"

# ====== 仓库源配置 ======
# 默认从 DataInfraLab 组织拉取所有仓。
#
# 场景 A — 全部 fork：只改 GITHUB_ORG
#   GITHUB_ORG="your_username"
#
# 场景 B — 单个 fork：覆盖对应的 _REPO_URL（会忽略 GITHUB_ORG）
#   ICEBERG_FDW_REPO_URL="https://github.com/your_fork/iceberg_fdw.git"
#
GITHUB_ORG="${GITHUB_ORG:-DataInfraLab}"

# 各仓 clone 地址（默认根据 GITHUB_ORG 拼接，可单独覆盖）
OPENGAUSS_REPO_URL="${OPENGAUSS_REPO_URL:-https://github.com/${GITHUB_ORG}/openGauss-server-datainfra.git}"
ICEBERG_INDEX_REPO_URL="${ICEBERG_INDEX_REPO_URL:-https://github.com/${GITHUB_ORG}/iceberg-index.git}"
ICEBERG_BRIDGE_REPO_URL="${ICEBERG_BRIDGE_REPO_URL:-https://github.com/${GITHUB_ORG}/iceberg-rust-bridge.git}"
ICEBERG_FDW_REPO_URL="${ICEBERG_FDW_REPO_URL:-https://github.com/${GITHUB_ORG}/iceberg_fdw.git}"
ICEBERG_CATALOG_REPO_URL="${ICEBERG_CATALOG_REPO_URL:-https://github.com/${GITHUB_ORG}/openGauss-Catalog.git}"
ICEBERG_DELTA_REPO_URL="${ICEBERG_DELTA_REPO_URL:-https://github.com/${GITHUB_ORG}/iceberg_delta.git}"

# iceberg-index 在 Cargo.toml 中声明的 git 依赖地址（cargo patch 匹配用）
# 仅当你 fork 了 iceberg-index 且修改了 bridge 的 Cargo.toml 时才需要改
ICEBERG_INDEX_CARGO_URL="${ICEBERG_INDEX_CARGO_URL:-https://github.com/DataInfraLab/iceberg-index.git}"

# GitHub 认证（如果服务器无法匿名访问 GitHub）
# Classic PAT: Settings → Developer settings → Personal access tokens → Tokens (classic)
# 勾选 public_repo 即可
# GITHUB_USER="your_username"
# GITHUB_TOKEN="ghp_xxxx"

# Rust 镜像（国内加速）
# rustup 安装 toolchain 用 rsproxy（速度最快）
# 可选: https://mirrors.tuna.tsinghua.edu.cn/rustup
#       https://mirrors.ustc.edu.cn/rust-static/rustup
RUSTUP_DIST_SERVER="${RUSTUP_DIST_SERVER:-https://rsproxy.cn}"
RUSTUP_UPDATE_ROOT="${RUSTUP_UPDATE_ROOT:-https://rsproxy.cn/rustup}"

# 编译模式: debug | release | memcheck
BUILD_MODE="${BUILD_MODE:-debug}"

# 编译并发数
BUILD_JOBS="${BUILD_JOBS:-8}"
